    "safety": { "id": "safety", "kind": "safety", "section": "safety" },
    "pmh": {
      "id": "pmh", "kind": "multi", "section": "history",
      "ask": {
        "en": "Do you have any long-standing illnesses, or past operations? For example: high BP, sugar (diabetes), asthma, thyroid, heart problem. Choose all that apply — or type.",
        "hi": "क्या आपको कोई पुरानी बीमारी है, या कोई ऑपरेशन हुआ है? जैसे — उच्च रक्तचाप, शुगर, दमा, थायराइड, दिल की बीमारी। जो लागू हो चुनिए — या लिखिए।",
        "rom": "Kya aapko koi purani bimari hai, ya koi operation hua hai? Jaise — BP, sugar, daama, thyroid, dil ki bimari. Jo lagu ho chuniye — ya likhiye."
      },
      "options": [
        { "v": "htn", "en": "High blood pressure", "hi": "उच्च रक्तचाप (BP)" },
        { "v": "dm", "en": "Diabetes (sugar)", "hi": "शुगर (मधुमेह)" },
        { "v": "asthma", "en": "Asthma / breathing problem", "hi": "दमा / सांस की बीमारी" },
        { "v": "thyroid", "en": "Thyroid", "hi": "थायराइड" },
        { "v": "cardiac", "en": "Heart problem", "hi": "दिल की बीमारी" },
        { "v": "none_pmh", "en": "None of these", "hi": "इनमें से कोई नहीं", "exclusive": true }
      ]
    },
