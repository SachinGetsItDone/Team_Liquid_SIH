        { "v": "sweating", "en": "Sweating", "hi": "पसीना आना", "rfTerm": "concern" },
        { "v": "nausea", "en": "Nausea or vomiting", "hi": "मतली या उल्टी", "rfTerm": "concern" },
        { "v": "fever", "en": "Fever", "hi": "बुखार" },
        { "v": "dizzy", "en": "Fainting or dizziness", "hi": "चक्कर या बेहोशी", "rfTerm": "concern" },
        { "v": "swelling", "en": "Swelling nearby", "hi": "पास में सूजन" },
        { "v": "none_assoc", "en": "None of these", "hi": "इनमें से कोई नहीं", "exclusive": true }
