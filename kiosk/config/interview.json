        { "v": "burning", "en": "Burning", "hi": "जलन" },
        { "v": "throbbing", "en": "Throbbing", "hi": "धड़कने जैसा" },
        { "v": "dull", "en": "Dull ache", "hi": "हल्का दर्द" }
      ]
    },
    "socrates.radiation": {
      "id": "socrates.radiation", "kind": "chips", "section": "symptoms", "field": "radiation",
      "ask": {
        "en": "Does it spread anywhere else in the body?",
        "hi": "क्या यह दर्द शरीर के किसी और हिस्से तक जाता है?",
