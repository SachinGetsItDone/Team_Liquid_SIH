    "socrates.timing": {
      "id": "socrates.timing", "kind": "chips", "section": "symptoms", "field": "timing",
      "ask": {
        "en": "Is it there all the time, or does it come and go?",
        "hi": "यह हमेशा रहती है, या आती-जाती है?",
