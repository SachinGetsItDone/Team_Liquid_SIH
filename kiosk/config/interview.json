  "turns": {
    "narrative": {
      "id": "narrative", "kind": "text", "section": "story",
      "ask": {
        "en": "Namaste. Please tell us in your own words — what problem brought you to the hospital today? Speak or type as much as you like. Take your time.",
        "hi": "नमस्ते। अपने शब्दों में बताइए — आज आप अस्पताल किस समस्या से आए हैं? जितना चाहें बोलिए या लिखिए।",
        "rom": "Namaste. Apne shabdon mein bataiye — aaj aap hospital kis samasya se aaye hain? Jitna chaahein boliye ya likhiye."
      }
    },
    "cc": {
      "id": "cc", "kind": "cc", "section": "story",
      "askConfirm": {
        "en": "We have noted your main problem as shown below. Is that correct?",
        "hi": "हमने आपकी मुख्य समस्या नीचे दर्ज की है। क्या यह सही है?",
        "rom": "Humne aapki mushkil samasya neeche darj ki hai. Kya yeh sahi hai?"
      },
      "askOpen": {
        "en": "In one line — what is your main problem today?",
        "hi": "एक लाइन में बताइए — आज आपकी मुख्य समस्या क्या है?",
        "rom": "Ek line mein bataiye — aaj aapki mushkil samasya kya hai?"
      }
    },
    "bodymap": {
      "id": "bodymap", "kind": "bodymap", "section": "story",
      "ask": {
        "en": "Show us where it hurts — tap the body region. No need to read or speak.",
        "hi": "दिखाइए दर्द कहाँ है — शरीर के हिस्से पर उंगली रखिए। पढ़ने या बोलने की ज़रूरत नहीं।",
        "rom": "Dikhaiye dard kahan hai — sharir ke hisse par ungli rakhiye. Padhne ya bolne ki zaroorat nahi."
      }
    },
    "socrates.site": {
      "id": "socrates.site", "kind": "chips", "section": "symptoms", "field": "site",
      "ask": {
        "en": "Your main problem — where exactly do you feel it? (You can point with one finger.)",
        "hi": "आपकी समस्या — शरीर के ठीक कहाँ महसूस होती है? (एक उंगली से इशारा कर सकते हैं।)",
        "rom": "Aapki samasya — sharir ke theek kahan mehsoos hoti hai? (Ek ungli se ishara kar sakte hain.)"
      },
      "options_by_complaint": {
        "chest": [
          { "v": "chest_center", "en": "Centre of the chest", "hi": "छाती के बीच में" },
          { "v": "chest_left", "en": "Left side of the chest", "hi": "छाती के बाईं ओर" },
          { "v": "chest_whole", "en": "Whole chest", "hi": "पूरी छाती" },
          { "v": "other_site", "en": "Somewhere else", "hi": "कहीं और" }
        ],
        "knee": [
          { "v": "knee_right", "en": "Right knee", "hi": "दायाँ घुटना" },
          { "v": "knee_left", "en": "Left knee", "hi": "बायाँ घुटना" },
          { "v": "knee_both", "en": "Both knees", "hi": "दोनों घुटने" },
          { "v": "other_site", "en": "Somewhere else", "hi": "कहीं और" }
        ]
