      "options": [
        { "v": "constant", "en": "Constant since it started", "hi": "शुरू होने से लगातार है" },
        { "v": "comes_goes", "en": "Comes and goes", "hi": "आती-जाती है" },
        { "v": "with_activity", "en": "Only with activity", "hi": "सिर्फ़ काम करते समय" },
