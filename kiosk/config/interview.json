      "options": [
        { "v": "worse_exertion", "en": "Worse on walking / exertion", "hi": "चलने-फिरने से बढ़ती है" },
        { "v": "better_rest", "en": "Better with rest", "hi": "आराम से कम होती है" },
        { "v": "worse_food", "en": "Worse after food", "hi": "खाने के बाद बढ़ती है" },
        { "v": "worse_stairs", "en": "Worse on stairs / squatting", "hi": "सीढ़ी या बैठने-उठने से बढ़ती है" },
