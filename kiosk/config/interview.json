      "options": [
        { "v": "other_site", "en": "Somewhere else", "hi": "कहीं और" }
      ]
    },
    "socrates.onset": {
      "id": "socrates.onset", "kind": "chips", "section": "symptoms", "field": "onset",
      "ask": {
        "en": "When did it start — and how: suddenly or gradually?",
        "hi": "इसकी शुरूआत कब हुई और कैसे — अचानक या धीरे-धीरे?",
        "rom": "Iski shuruaat kab hui aur kaise — achanak ya dheere-dheere?"
