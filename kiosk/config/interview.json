    "socrates.severity": {
      "id": "socrates.severity", "kind": "scale", "section": "symptoms", "field": "severity",
      "min": 0, "max": 10,
      "ask": {
        "en": "If 0 is no pain and 10 is the worst you can imagine — what number is it right now?",
        "hi": "अगर 0 का मतलब कोई दर्द नहीं और 10 का मतलब सबसे बुरा दर्द — तो अभी कौन-सा नंबर लगता है?",
        "rom": "Agar 0 matlab koi dard nahi, 10 matlab sabse bura dard — toh abhi kaunsa number lagta hai?"
      }
