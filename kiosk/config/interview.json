    { "id": "ros", "label": { "en": "Other symptoms", "hi": "अन्य लक्षण", "rom": "Anya lakshan" }, "turns": "ROS_DYNAMIC" },
    { "id": "ice", "label": { "en": "Your thoughts", "hi": "आपके विचार", "rom": "Aapke vichaar" }, "turns": ["ice.worry", "ice.expect"] },
