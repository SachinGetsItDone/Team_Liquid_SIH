    { "id": "story", "label": { "en": "Your story", "hi": "आपकी बात", "rom": "Aapki baat" }, "turns": ["bodymap", "narrative", "cc"] },
    { "id": "symptoms", "label": { "en": "Symptom details", "hi": "लक्षण विवरण", "rom": "Lakshan vivaran" }, "turns": ["socrates.site", "socrates.onset", "socrates.character", "socrates.radiation", "socrates.associations", "socrates.timing", "socrates.exacerbating", "socrates.severity"] },
    { "id": "safety", "label": { "en": "Safety check", "hi": "सुरक्षा जाँच", "rom": "Suraksha jaanch" }, "turns": ["safety"] },
