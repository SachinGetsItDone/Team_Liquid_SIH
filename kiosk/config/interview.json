      "options": [
        { "v": "sud_min", "en": "Sudden — within minutes", "hi": "अचानक — कुछ मिनटों में", "terms": ["sudden", "achanak"] },
        { "v": "hours", "en": "Over a few hours", "hi": "कुछ घंटों में" },
        { "v": "days", "en": "Over a few days", "hi": "कुछ दिनों में" },
        { "v": "weeks", "en": "Over a few weeks", "hi": "कुछ हफ़्तों में" },
        { "v": "month_plus", "en": "More than a month ago", "hi": "एक महीने से ज़्यादा पहले" }
      ]
    },
    "socrates.character": {
      "id": "socrates.character", "kind": "chips", "section": "symptoms", "field": "character",
      "ask": {
        "en": "What does it feel like — what kind of pain or discomfort is it?",
        "hi": "यह कैसा दर्द है — कैसा महसूस होता है?",
        "rom": "Yeh kaisa dard hai — kaisa mehsoos hota hai?"
